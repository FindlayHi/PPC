---
layout: layouts/base.njk
title: "House Cleaning in Port Credit | Port Credit Cleaning"
description: "Professional, locally-owned house & condo cleaning in Port Credit, Mississauga. Recurring, deep, move-in/out, condo & Airbnb. Book online or call (289) 643-4207."
---

{# ── HERO ── #}
<section class="hero-light">
  <div class="max-w-[1180px] mx-auto px-8 py-[74px] grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <p class="text-olive text-[12.5px] font-semibold uppercase tracking-[0.13em] mb-4">House &amp; condo cleaning &middot; South Mississauga</p>
      <h1 class="font-display font-extrabold leading-[1.02] tracking-[-0.03em] text-[48px] md:text-[60px] mb-5"><span class="text-olive-bright">Professional house cleaning</span> <span class="text-forest">in Port Credit.</span></h1>
      <p class="text-[#4B5A50] text-[18px] leading-relaxed mb-8">Reliable cleaning services for homes and condos throughout Port Credit and South Mississauga.</p>
      <div class="flex flex-wrap gap-3 mb-10">
        <a href="#quote" class="bg-lime hover:bg-lime-hover text-forest font-semibold text-[15px] px-6 py-3 rounded-full transition-colors duration-150">Get a Free Quote</a>
        <a href="{{ site.phoneSms }}" class="border-[1.5px] border-forest text-forest hover:bg-forest hover:text-white font-semibold text-[15px] px-6 py-[10.5px] rounded-full transition-colors duration-150">Text Us</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13.5px] text-[#4B5A50]">
        <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-lime" aria-hidden="true"></span>Satisfaction guaranteed</span>
      </div>
    </div>
    <div class="hidden md:block">
      <div class="blob-frame">
        <div class="blob-img w-full aspect-[4/3]">
          {% image "/img/bailey-alexander-cYeCxtKpTTQ-unsplash.jpg", "Bright, clean open-plan kitchen in a Port Credit home", "w-full h-full object-cover", "(min-width: 768px) 50vw, 100vw" %}
        </div>
      </div>
    </div>
  </div>
</section>

{# ── TRUST STRIP ── #}
<section class="bg-white border-b border-[#DCE3D8]">
  <div class="max-w-[1180px] mx-auto px-8 py-10 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="flex items-start gap-3.5">
      <span class="shrink-0 w-9 h-9 rounded-full bg-forest flex items-center justify-center" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      </span>
      <div>
        <p class="font-display font-bold text-forest text-[17px] mb-1">Locally Owned</p>
        <p class="text-[#4B5A50] text-[14.5px] leading-relaxed">Run by your neighbours in Port Credit — not a faceless franchise.</p>
      </div>
    </div>
    <div class="flex items-start gap-3.5">
      <span class="shrink-0 w-9 h-9 rounded-full bg-lime flex items-center justify-center" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F4A3A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12.5 10 17 19 7"/></svg>
      </span>
      <div>
        <p class="font-display font-bold text-forest text-[17px] mb-1">Consistent Quality</p>
        <p class="text-[#4B5A50] text-[14.5px] leading-relaxed">A consistent, dedicated cleaner for your home, with a detailed checklist.</p>
      </div>
    </div>
    <div class="flex items-start gap-3.5">
      <span class="shrink-0 w-9 h-9 rounded-full bg-amber flex items-center justify-center" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F4A3A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 4 14 12 14 11 22 20 10 12 10 13 2"/></svg>
      </span>
      <div>
        <p class="font-display font-bold text-forest text-[17px] mb-1">Flexible Scheduling</p>
        <p class="text-[#4B5A50] text-[14.5px] leading-relaxed">Weekly, biweekly, monthly or one-time — around your routine.</p>
      </div>
    </div>
  </div>
</section>

{# ── SERVICES GRID ── #}
<section class="py-20 bg-surface">
  <div class="max-w-[1180px] mx-auto px-8">
    <p class="text-olive text-[12.5px] font-semibold uppercase tracking-[0.13em] mb-3">What we clean</p>
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
      <h2 class="font-display font-extrabold text-forest text-[36px] leading-[1.1] tracking-[-0.022em] max-w-[480px]">Cleaning services for every kind of home</h2>
      <a href="/services/" class="text-olive font-semibold text-[14.5px] hover:underline shrink-0">View all services &rarr;</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]">
      {% for s in services %}
      {% set card = s %}
      {% include "partials/service-card.njk" %}
      {% endfor %}
      {# CTA tile #}
      <div class="bg-sage rounded-[16px] p-6 flex flex-col justify-between">
        <div>
          <p class="font-display font-bold text-forest text-[20px] mb-2 leading-snug">Not sure what you need?</p>
          <p class="text-[#4B5A50] text-[14.5px] leading-relaxed mb-6">Tell us about your home and we'll recommend the right clean — with honest pricing.</p>
        </div>
        <a href="#quote" class="bg-lime hover:bg-lime-hover text-forest font-semibold text-[14px] px-5 py-2.5 rounded-full text-center transition-colors duration-150 self-start">Get a Free Quote</a>
      </div>
    </div>
  </div>
</section>

{# ── WHY CHOOSE US ── #}
<section id="why-us" class="py-20 bg-white">
  <div class="max-w-[1180px] mx-auto px-8 grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
    <div class="relative">
      <div class="rounded-[20px] overflow-hidden w-full aspect-[4/3]">
        {% image "/img/giorgio-trovato-5TXz228u4eo-unsplash.jpg", "Professional cleaner at work in a home", "w-full h-full object-cover", "(min-width: 768px) 50vw, 100vw" %}
      </div>
      <div class="absolute -bottom-6 -right-5 bg-amber px-7 py-5 text-center" style="border-radius: 55% 45% 52% 48% / 48% 55% 45% 52%; box-shadow: 0 16px 38px rgba(31,74,58,.14);">
        <p class="font-display font-extrabold text-forest text-[32px] leading-none">8 yrs</p>
        <p class="text-forest text-[13px] font-medium mt-0.5">cleaner experience</p>
      </div>
    </div>
    <div>
      <p class="text-olive text-[12.5px] font-semibold uppercase tracking-[0.13em] mb-3">Why choose us</p>
      <h2 class="font-display font-extrabold text-forest text-[36px] leading-[1.1] tracking-[-0.022em] mb-4">A cleaner who actually knows your home</h2>
      <p class="text-[#4B5A50] text-[17px] leading-relaxed mb-7">No rotating crews, no surprises. Just dependable, detailed cleaning from a team that treats your home like their own.</p>
      <ul class="space-y-3.5">
        {% set checks = [
          ["A small, local, owner-operated team.", "No call centers, no rotating franchise crews."],
          ["Attention to detail.", "A consistent checklist so nothing gets missed."],
          ["Eco-friendly products available.", "Safe for kids, pets and sensitive homes."],
          ["Flexible scheduling.", "Easy to book, easy to reschedule when life happens."],
          ["Friendly & professional.", "Punctual, respectful and easy to reach."]
        ] %}
        {% for check in checks %}
        <li class="flex items-start gap-3">
          <span class="shrink-0 w-5 h-5 rounded-full bg-lime flex items-center justify-center mt-0.5">
            <svg width="10" height="8" viewBox="0 0 10 8" fill="none" stroke="#1F4A3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 3.5 6.5 9 1"/></svg>
          </span>
          <p class="text-[15px] text-ink leading-relaxed"><strong class="font-semibold">{{ check[0] }}</strong> {{ check[1] }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ── TESTIMONIALS ── #}
<section id="testimonials" class="py-20 bg-surface">
  <div class="max-w-[1180px] mx-auto px-8">
    <p class="text-olive text-[12.5px] font-semibold uppercase tracking-[0.13em] mb-3">Testimonials</p>
    <div class="mb-10">
      <h2 class="font-display font-extrabold text-forest text-[36px] leading-[1.1] tracking-[-0.022em]">Loved by homeowners across South Mississauga</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-[22px]">
      {% for testimonial in testimonials %}
      {% include "partials/review-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

{# ── SERVICE AREA ── #}
<section id="service-area" class="py-20 bg-white">
  <div class="max-w-[1180px] mx-auto px-8 grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
    <div>
      <p class="text-olive text-[12.5px] font-semibold uppercase tracking-[0.13em] mb-3">Service area</p>
      <h2 class="font-display font-extrabold text-forest text-[36px] leading-[1.1] tracking-[-0.022em] mb-4">Proudly serving Port Credit &amp; South Mississauga</h2>
      <p class="text-[#4B5A50] text-[17px] leading-relaxed mb-6">Looking for a trusted house cleaner near you? We clean homes, condos and rentals throughout the Port Credit lakeshore and surrounding neighbourhoods.</p>
      <div class="flex flex-wrap gap-2 mb-6">
        {% for n in site.neighborhoods %}
        <span class="border-[1.5px] border-forest text-forest font-medium text-[13px] px-3.5 py-1 rounded-full">{{ n }}</span>
        {% endfor %}
      </div>
      <a href="#quote" class="text-olive font-semibold text-[15px] hover:underline">Check my neighbourhood &rarr;</a>
    </div>
    <div class="rounded-[20px] overflow-hidden w-full aspect-[4/3]">
      <iframe
        src="https://maps.google.com/maps?q=Port+Credit,+Mississauga+ON&output=embed&z=13"
        width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Port Credit, Mississauga ON map"></iframe>
    </div>
  </div>
</section>

{# ── QUOTE FORM ── #}
<section class="py-20 bg-surface">
  <div class="max-w-[1180px] mx-auto px-8 grid grid-cols-1 md:grid-cols-2 gap-14">
    <div>
      <p class="text-olive text-[12.5px] font-semibold uppercase tracking-[0.13em] mb-3">Free quote</p>
      <h2 class="font-display font-extrabold text-forest text-[36px] leading-[1.1] tracking-[-0.022em] mb-4">Get your free quote</h2>
      <p class="text-[#4B5A50] text-[17px] leading-relaxed mb-8">Tell us a little about your home and we'll get back to you the same day with honest, upfront pricing.</p>
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-lime-tint rounded-[12px] flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="#5E7D14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg>
          </div>
          <div>
            <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#6B7280]">Call or text</p>
            <a href="{{ site.phoneTel }}" class="text-forest font-semibold text-[15px] hover:text-olive transition-colors duration-150">{{ site.phone }}</a>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-lime-tint rounded-[12px] flex items-center justify-center shrink-0">
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="#5E7D14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#6B7280]">Email</p>
            <a href="mailto:{{ site.email }}" class="text-forest font-semibold text-[15px] hover:text-olive transition-colors duration-150">{{ site.email }}</a>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-white rounded-[20px] p-8" style="box-shadow: 0 10px 30px rgba(31,74,58,.05);">
      {% set formType = "full" %}
      {% include "partials/quote-form.njk" %}
    </div>
  </div>
</section>
